FOOTBALL_ADMIN_DATABASE_URL=
FOOTBALL_IMPORT_DATABASE_URL=

# Vercel: dedicated reader connection, Transaction pooler, sslmode=require.
FOOTBALL_STORAGE=local
FOOTBALL_DATABASE_URL=
